        <mxCell id="3-UMOmhkEuNXTupGRrpj-16" parent="3-UMOmhkEuNXTupGRrpj-10" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;fontSize=16;" value="FLUJO PRINCIPAL" vertex="1">

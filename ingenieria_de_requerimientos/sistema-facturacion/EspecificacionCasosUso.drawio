        <mxCell id="3-UMOmhkEuNXTupGRrpj-11" parent="3-UMOmhkEuNXTupGRrpj-10" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;fontSize=16;align=left;" value="&lt;ol&gt;&lt;li&gt;El usuario selecciona la opcion de registrar cliente.&lt;/li&gt;&lt;li&gt;El sistema le pide que ingrese el nombre del cliente&lt;/li&gt;&lt;li&gt;El usuario ingresa un nombre valido para el cliente&lt;/li&gt;&lt;li&gt;El sistema le pide que ingrese la identificacion del cliente&lt;/li&gt;&lt;li&gt;El usuario ingresa un numero valido para la identificacion del cliente&lt;/li&gt;&lt;li&gt;El sistema le pide que ingrese un correo electronico.&lt;/li&gt;&lt;li&gt;El usuario ingresa un correo valido para el cliente.&lt;/li&gt;&lt;li&gt;El sistema le pide que ingrese una direccion valida&lt;/li&gt;&lt;li&gt;El usuario ingresa una direccion valida para el cliente.&lt;/li&gt;&lt;li&gt;El sistema muestra un mensaje que el cliente fue registrado.&lt;/li&gt;&lt;/ol&gt;" vertex="1">
          <mxGeometry height="290" width="587" x="183" as="geometry">
            <mxRectangle height="290" width="587" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="3-UMOmhkEuNXTupGRrpj-17" parent="3-UMOmhkEuNXTupGRrpj-1" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;top=0;left=0;bottom=0;right=0;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=16;" vertex="1">
